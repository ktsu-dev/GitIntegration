<Project>
  <Sdk Name="Microsoft.NET.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ktsu.CredentialCache" />
    <PackageReference Include="ktsu.Essentials" />
    <PackageReference Include="ktsu.Essentials.FileSystemProviders.Native" />
    <PackageReference Include="ktsu.RunCommand" />
    <PackageReference Include="ktsu.Semantics.Paths" />
    <PackageReference Include="ktsu.Semantics.Strings" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Octokit" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />

    <!-- System.Text.Json ships in-box with the net9.0/net10.0 shared framework, but AzureDevOpsProvider
         and AzureDevOpsJson use its types directly (JsonSerializer, JsonSerializerContext), which the
         KTSU0006 analyzer treats as direct use of a transitively-available package requiring its own
         reference. PrivateAssets="all" because this reference exists only to satisfy the analyzer, not
         as part of this library's public surface.

         Here the lower resolver is the SHARED FRAMEWORK, not another package — the same failure
         mode on a different asset, and the version matters a great deal: an earlier version of this
         reference pinned System.Text.Json to 10.0.2, whose lib/net9.0 folder ships a REAL assembly
         (AssemblyVersion 10.0.0.0), so a net9.0 build compiled against a reference higher than any real
         .NET 9 installation carries (9.0.0.0). Since PrivateAssets="all" keeps this package out of the
         published .nupkg, a net9.0 consumer would get no copy of the higher version either — only the
         framework's 9.0.0.0 — and CoreCLR rolls binds forward within the trusted platform assembly list,
         never backward, so that consumer would hit FileNotFoundException at runtime.

         Fixed by pinning to 9.0.13 instead. Confirmed via project.assets.json's compile asset for THIS
         package after that change, for both targets: net9.0 -> lib/net9.0/_._, net10.0 -> lib/net9.0/_._
         — an empty placeholder both times, meaning this package contributes nothing at compile time for
         either target framework; each build's own implicit FrameworkReference reference assembly
         supplies System.Text.Json instead. Confirmed a second way, by reflecting on the actual build
         output: bin/Debug/net9.0/ktsu.GitIntegration.dll references System.Text.Json Version=9.0.0.0;
         bin/Debug/net10.0/ktsu.GitIntegration.dll references System.Text.Json Version=10.0.0.0 — each
         exactly matching what that target framework's own shared framework ships (verified against the
         installed net8.0/8.0.30 and net10.0/10.0.11 shared frameworks, whose System.Text.Json.dll
         AssemblyVersion is always major.minor.0.0 regardless of patch — the standing .NET convention
         that is why this holds for the uninstalled net9.0 framework too, not merely this machine's
         installed ones). No VersionOverride or per-TargetFramework condition was needed: a single
         central version below both frameworks' floor resolved safely for both, and nothing else in this
         graph pins System.Text.Json to a conflicting version.

         NoWarn="NU1510" is required alongside this: pinning to a version the SDK's package-pruning
         feature recognises as already covered by the framework makes it warn "Remove the
         PackageReference item" — which is precisely the thing KTSU0006 forbids doing. Two SDK-level
         checks disagree with each other here; this keeps the analyzer's requirement and silences only
         the one restore diagnostic that contradicts it, scoped to this single PackageReference rather
         than the whole project. -->
    <PackageReference Include="System.Text.Json" PrivateAssets="all" NoWarn="NU1510" />

    <!-- ktsu.Essentials's IFileSystemProvider is a marker interface with no members of its own; it
         inherits System.IO.Abstractions.IFileSystem straight from Testably.Abstractions.FileSystem
         .Interface. GitCloneBuilder's destination pre-check calls members declared on that base
         interface (Directory.Exists, Directory.GetFileSystemEntries), which the KTSU0006 analyzer
         treats as direct use of a transitively-referenced package requiring its own reference.
         VersionOverride pins this reference to 10.0.0 rather than letting central transitive pinning
         apply the repo-wide 10.3.0: ktsu.Essentials 2.0.0's own nuspec pins 10.0.0, and CoreCLR only
         rolls assembly binds forward, never backward. A consumer resolves whichever version
         ktsu.Essentials pins, so this library must compile against the lowest version any consumer
         could resolve — a higher reference here cannot bind against a lower assembly at runtime and
         would throw FileNotFoundException for every consumer. -->
    <PackageReference Include="Testably.Abstractions.FileSystem.Interface" VersionOverride="10.0.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
